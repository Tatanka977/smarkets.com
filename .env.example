# Copy this file to .env and fill in real values. Never commit .env.

# Supabase (required — auth, database, storage)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only, elevated privileges — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# AI advisor — Groq is the primary provider (src/lib/ai.functions.ts)
GROQ_API_KEY=

# AI advisor — optional automatic fallback when Groq's quota is exhausted
GEMINI_API_KEY=

# Market data (quotes, search, historical prices, FX rates)
FINNHUB_API_KEY=
